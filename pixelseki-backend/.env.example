# Database
DATABASE_URL=postgresql+asyncpg://forceki:@localhost:5432/pixel_generation

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
DEFAULT_PROVIDER=gemini  # "gemini" or "openai"

# AWS S3 Storage (leave S3_BUCKET empty to use local disk)
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=staging
BASE_ASSETS_URL=  # e.g. https://pixelseki.s3.ap-southeast-1.amazonaws.com or CDN URL

# JWT
JWT_SECRET_KEY=your-super-secret-key-23012!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60000

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
